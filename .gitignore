# =============================================================================
# SU_DevOps Master .gitignore Specification
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/

# Pytest / Coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/
reports/
*.xml

# Terraform State and cache files
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
*.tvars

# Ansible retry files
*.retry

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.log

# Sensitive credentials and private keys
*.pem
*.key
*.pub
id_rsa*
aws_credentials
